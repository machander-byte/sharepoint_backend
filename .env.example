# zettalogixmigrationsuite (ZMS) safe environment placeholders.
# Do not commit real secrets. Frontend VITE_* values are browser-visible.

# Frontend
VITE_API_BASE_URL=https://your-zms-api-host
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-public-supabase-publishable-key
VITE_GOOGLE_CLIENT_ID=your-browser-google-oauth-client-id
VITE_GOOGLE_API_KEY=your-browser-google-picker-api-key
VITE_GOOGLE_APP_ID=your-google-cloud-project-number
VITE_GOOGLE_DRIVE_SCOPE=https://www.googleapis.com/auth/drive.readonly
VITE_APP_COMMIT=local
VITE_APP_BUILD_TIME=local

# Backend
ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://localhost:5206
Database__Provider=Postgres
ConnectionStrings__ZmsDatabase=Host=your-supabase-pooler-host;Port=5432;Database=postgres;Username=postgres.your-project-ref;Password=your-database-password;SSL Mode=Require;Trust Server Certificate=true
DataProtection__KeyStorage=Database
DataProtection__KeyRingPath=
Supabase__Auth__Authority=https://your-project.supabase.co/auth/v1
Supabase__Auth__Audience=authenticated
Authorization__EnforceRoles=false
Cors__AllowedOrigins__0=https://your-frontend-host
RequestLimits__MaxBodyBytes=50000000
Sentry__Dsn=
Sentry__TracesSampleRate=0.0

# Optional backend Google Drive connector
GOOGLE_CLIENT_ID=your-backend-google-oauth-client-id
GOOGLE_CLIENT_SECRET=your-backend-google-oauth-client-secret
GOOGLE_REFRESH_TOKEN=your-backend-google-offline-refresh-token

# Optional Microsoft connector values are normally stored through backend connection profiles.
MICROSOFT_TENANT_ID=your-tenant-id
MICROSOFT_CLIENT_ID=your-entra-application-client-id
MICROSOFT_CLIENT_SECRET=your-entra-client-secret
