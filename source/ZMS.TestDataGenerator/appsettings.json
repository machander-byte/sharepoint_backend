{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "Generation": {
    "FileCount": 1000,
    "MaxDepth": 10,
    "MaxFileSizeMb": 50,
    "OutputPath": "./TestTenant",
    "Parallelism": 4,
    "ManifestBatchSize": 100,
    "WriteBufferSizeKb": 1024,
    "IncludeEdgeCases": true,
    "LongPathFileCount": 10,
    "LongPathTargetCharacters": 320,
    "DuplicateNameSetCount": 3,
    "CorruptedFileCount": 6,
    "SpecialCharacterFileCount": 10,
    "HugeSingleFolderFileCount": 100,
    "PermissionEdgeCaseCount": 10
  },
  "Presets": {
    "Small": 100,
    "Medium": 1000,
    "Large": 10000,
    "XLarge": 50000,
    "Huge": 100000
  }
}
